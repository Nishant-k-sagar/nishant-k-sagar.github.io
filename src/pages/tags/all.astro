---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { buildTagNetwork, type SourceItem } from '../../utils/tags';

const blog = await getCollection(
  'blog',
  ({ data }) => data.status === 'published',
);
const projects = await getCollection(
  'projects',
  ({ data }) => data.status === 'published',
);

const sources: SourceItem[] = [
  ...blog.map((post) => ({
    id: `blog/${post.id}`,
    type: 'blog' as const,
    title: post.data.title,
    date: post.data.date,
    tags: post.data.tags,
    url: `/blog/${post.id}/`,
    excerpt: post.data.seo_description ?? post.data.excerpt,
  })),
  ...projects.map((project) => ({
    id: `project/${project.id}`,
    type: 'project' as const,
    title: project.data.title,
    date: project.data.date,
    tags: project.data.tags,
    url: `/projects/${project.id}/`,
    excerpt: project.data.excerpt,
  })),
];

const network = buildTagNetwork(sources);

// Alphabetical by label, grouped by first letter (A-Z dictionary).
const alphaTags = [...network.tags].sort((a, b) =>
  a.label.localeCompare(b.label),
);

interface LetterGroup {
  letter: string;
  tags: typeof alphaTags;
}

const groups: LetterGroup[] = [];
for (const tag of alphaTags) {
  const letter = tag.label.charAt(0).toUpperCase();
  const key = /^[A-Z]$/.test(letter) ? letter : '#';
  const last = groups[groups.length - 1];
  if (last && last.letter === key) last.tags.push(tag);
  else groups.push({ letter: key, tags: [tag] });
}

const letters = groups.map((group) => group.letter);
---

<BaseLayout
  title="Nishant Kumar Sagar | All tags"
  description="All tags on this site in alphabetical order."
>
  <Header />

  <main class="flex-1">
    <section class="py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <nav aria-label="Breadcrumb" class="text-xs text-text-3 mb-3">
          <a href="/tags/" class="hover:text-accent">Tags</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page" class="text-text-2">All tags</span>
        </nav>

        <h1 class="text-lg sm:text-xl lg:text-2xl font-bold font-sans text-green-600 underline decoration-green-600 mb-5">All tags</h1>

        <nav aria-label="Alphabet" class="sticky top-12 sm:top-14 z-30 flex flex-wrap gap-x-4 gap-y-2 mb-8 py-2 bg-bg border-y border-border">
          {letters.map((letter) => (
            <a
              href={`#letter-${letter}`}
              class="text-xs text-accent hover:underline font-medium"
            >
              {letter}
            </a>
          ))}
        </nav>

        <div class="space-y-8">
          {groups.map((group) => (
            <section id={`letter-${group.letter}`} class="scroll-mt-24">
              <h2 class="text-base sm:text-lg font-bold font-serif text-text border-b border-border pb-2 mb-2">
                {group.letter}
              </h2>
              <ul class="divide-y divide-border/50">
                {group.tags.map((tag) => (
                  <li>
                    <a
                      href={`/tags/#${tag.slug}`}
                      class="flex items-baseline justify-between gap-4 py-2.5 px-2 -mx-2 rounded-md group hover:bg-bg-2 transition-colors"
                    >
                      <span class="font-sans font-normal text-sm text-text group-hover:text-accent group-hover:underline transition-colors">
                        {tag.label}
                      </span>
                      <span class="text-xs text-text-3 shrink-0">
                        {tag.count} item{tag.count === 1 ? '' : 's'} <span aria-hidden="true" class="group-hover:text-accent">&rarr;</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>

        <div class="mt-10 pt-6 border-t border-border">
          <a href="/tags/" class="text-sm text-accent hover:underline font-medium">&larr; Back to Tags</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
