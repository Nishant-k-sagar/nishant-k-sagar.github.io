---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BlogCard from "../components/BlogCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import { getCollection, render } from "astro:content";
import { sortPosts, sortProjects } from "../utils/sort-posts";

const allBlogPosts = await getCollection(
	"blog",
	({ data }) => data.status === "published",
);
const allProjects = await getCollection(
	"projects",
	({ data }) => data.status === "published",
);

// Home intro and skills come from content files (src/content/home, src/content/skills).
const introEntry = (
	await getCollection(
		"home",
		({ id, data }) => id === "intro" && data.status === "published",
	)
)[0];
const IntroContent = introEntry ? (await render(introEntry)).Content : null;
const skillGroups = (
	await getCollection("skills", ({ data }) => data.status === "published")
).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

// Work experience, newest first by start month (entries without a start go last).
const experiences = (
	await getCollection("experience", ({ data }) => data.status === "published")
).sort((a, b) => {
	const aStart = a.data.start ?? "";
	const bStart = b.data.start ?? "";
	if (aStart !== bStart) {
		if (!aStart) return 1;
		if (!bStart) return -1;
		return bStart.localeCompare(aStart);
	}
	return (
		a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
	);
});

// Filter only featured items first, then sort by date latest, take top 3
const recentPosts = sortPosts(
	allBlogPosts.filter((post) => post.data.featured === true),
	allBlogPosts,
).slice(0, 3);
const featuredProjects = sortProjects(
	allProjects.filter((project) => project.data.featured === true),
).slice(0, 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Nishant Kumar Sagar',
	url: 'https://nishant-k-sagar.github.io',
	sameAs: [
		'https://github.com/nishant-k-sagar',
		'https://linkedin.com/in/nishant-k-sagar',
	],
};
---

<BaseLayout title='Nishant Kumar Sagar | Home' jsonLd={jsonLd}>
	<Header />

	<main class='flex-1'>
		<!-- Hero Section -->
		<section
			class='relative py-4 sm:py-6 lg:py-8 px-4 sm:px-6 lg:px-8 overflow-hidden'>
			<div class='max-w-5xl mx-auto relative'>
				<h1
					class='text-3xl sm:text-4xl lg:text-5xl font-bold mb-2 sm:mb-3 font-serif text-text'>
					<span
						class='text-3xl sm:text-4xl lg:text-5xl'
						style='font-family: cursive; transform: rotate(-10deg);'
						>Hello<span class='text-green-600'>,</span></span
					>
					<span class='text-xl sm:text-2xl lg:text-3xl'>I am</span>
					<span class='text-green-600'>Nishant</span>
				</h1>
				<div class='hero-intro text-text-2 leading-relaxed font-sans max-w-2xl'>
					{IntroContent && <IntroContent />}
				</div>
			</div>
		</section>

		<!-- Experience -->
		{
			experiences.length > 0 && (
				<section class='py-4 sm:py-6 lg:py-8 px-4 sm:px-6 lg:px-8'>
					<div class='max-w-5xl mx-auto'>
						<div class='flex items-center justify-between mb-2 sm:mb-4'>
							<h2 class='text-base sm:text-lg lg:text-xl font-bold font-sans text-green-600 underline decoration-green-600'>
								Experience
							</h2>
						</div>
						<div>
							{experiences.map((entry) => (
								<ExperienceItem entry={entry} />
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- Featured blog posts -->
		{
			recentPosts.length > 0 && (
				<section class='py-4 sm:py-6 lg:py-8 px-4 sm:px-6 lg:px-8'>
					<div class='max-w-5xl mx-auto'>
						<div class='flex items-center justify-between mb-2 sm:mb-4'>
							<h2 class='text-base sm:text-lg lg:text-xl font-bold font-sans text-green-600 underline decoration-green-600'>
								Featured blog posts
							</h2>
							<a
								href='/blog'
								class='text-accent hover:text-text transition-colors text-sm sm:text-base font-medium border-b border-transparent hover:border-accent font-sans'>
								View all
							</a>
						</div>
						<div>
							{recentPosts.map((post) => (
								<BlogCard
									title={post.data.title}
									excerpt={post.data.excerpt}
									slug={post.id}
									date={post.data.date}
									tags={post.data.tags}
									postNumber={post.postNumber}
								/>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- Featured Projects -->
		{
			featuredProjects.length > 0 && (
				<section class='py-4 sm:py-6 lg:py-8 px-4 sm:px-6 lg:px-8'>
					<div class='max-w-5xl mx-auto'>
						<div class='flex items-center justify-between mb-2 sm:mb-4'>
							<h2 class='text-base sm:text-lg lg:text-xl font-bold font-sans text-green-600 underline decoration-green-600'>
								Featured Projects
							</h2>
							<a
								href='/projects'
								class='text-accent hover:text-text transition-colors text-sm sm:text-base font-medium border-b border-transparent hover:border-accent font-sans'>
								View all
							</a>
						</div>
						<div class='space-y-2 sm:space-y-3 lg:space-y-4'>
							{featuredProjects.map((project) => (
								<ProjectCard
									title={project.data.title}
									excerpt={project.data.excerpt}
									slug={project.id}
									date={project.data.date}
									tags={project.data.tags}
									github={project.data.github}
								/>
							))}
						</div>
					</div>
				</section>
			)
		}

		<!-- Empty State -->
		{
			recentPosts.length === 0 && featuredProjects.length === 0 && (
				<section class='py-8 sm:py-12 lg:py-16 px-4 sm:px-6 lg:px-8'>
					<div class='max-w-5xl mx-auto text-center'>
						<p class='text-text-2 text-sm sm:text-base'>
							Content coming soon! Add your blog posts and
							projects to the{" "}
							<code class='bg-bg-3 px-3 py-2 rounded text-sm text-text'>
								src/content/
							</code>{" "}
							directory.
						</p>
					</div>
				</section>
			)
		}

		<!-- Skills Section -->
		<section class='py-4 sm:py-6 lg:py-8 px-4 sm:px-6 lg:px-8'>
			<div class='max-w-5xl mx-auto'>
				<button
					id='skills-toggle'
					class='flex items-center gap-2 mb-2 sm:mb-4 w-full text-left'>
					<h2
						class='text-base sm:text-lg lg:text-xl font-bold font-sans text-green-600 underline decoration-green-600'>
						Skills
					</h2>
					<span
						id='skills-arrow'
						class='text-green-600 transition-transform duration-200'
						>▼</span
					>
				</button>

				<div
					id='skills-content'
					class='overflow-hidden max-h-0 transition-all duration-300 ease-in-out'>
					<div
						class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mt-2'>
						{skillGroups.map((group) => (
							<div
								class='bg-stone-50 dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 rounded-md p-2 sm:p-3 transition-colors'>
								<h3
									class='text-sm font-semibold mb-1.5 text-stone-900 dark:text-stone-100'>
									{group.data.title}
								</h3>
								<div class='flex flex-wrap gap-1'>
									{group.data.items.map((item) => (
										<span
											class='text-xs px-1.5 py-0.5 rounded bg-white dark:bg-zinc-800 border border-stone-200 dark:border-zinc-700 text-stone-700 dark:text-stone-300'
											>{item}</span
										>
									))}
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<script>
			document.addEventListener("DOMContentLoaded", () => {
				const toggle = document.getElementById("skills-toggle");
				const content = document.getElementById("skills-content");
				const arrow = document.getElementById("skills-arrow");

				if (toggle && content && arrow) {
					toggle.addEventListener("click", () => {
						const isExpanded =
							content.style.maxHeight !== "0px" &&
							content.style.maxHeight !== "";

						if (isExpanded) {
							content.style.maxHeight = "0px";
							arrow.style.transform = "rotate(0deg)";
						} else {
							content.style.maxHeight =
								content.scrollHeight + "px";
							arrow.style.transform = "rotate(180deg)";
						}
					});
				}
			});
		</script>
	</main>

	<Footer />
</BaseLayout>

<style>
	.hero-intro :global(p) {
		font-size: clamp(0.875rem, 2vw, 1.0625rem);
		line-height: 1.7;
		margin: 0;
		max-width: none;
	}
	.hero-intro :global(p + p) {
		margin-top: 1.7em;
	}
</style>
