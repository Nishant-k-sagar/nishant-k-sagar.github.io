---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { sortPosts } from '../utils/sort-posts';

const allBlogPosts = await getCollection('blog', ({ data }) => data.status === 'published');

const posts = sortPosts(allBlogPosts);

// Group by year (posts are already newest first). Year headings show only when posts span several years.
const groups: { year: string; posts: typeof posts }[] = [];
for (const post of posts) {
  const year = post.data.date.slice(0, 4);
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.posts.push(post);
  else groups.push({ year, posts: [post] });
}
const showYears = groups.length > 1;
---

<BaseLayout title="Nishant Kumar Sagar | Blogs" description="Articles on web development, tooling and workflow.">
  <Header />

  <main class="flex-1">
    <section class="py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-lg sm:text-xl lg:text-2xl font-bold font-sans text-green-600 underline decoration-green-600 mb-4">Blog</h1>

        {posts.length > 0 ? (
          <div>
            {groups.map((group) => (
              <section>
                {showYears && (
                  <h2 class="text-sm font-semibold font-sans text-text-2 mt-6 mb-1 first:mt-0">{group.year}</h2>
                )}
                {group.posts.map((post) => (
                  <BlogCard
                    title={post.data.title}
                    excerpt={post.data.excerpt}
                    slug={post.id}
                    date={post.data.date}
                    tags={post.data.tags}
                    postNumber={post.postNumber}
                  />
                ))}
              </section>
            ))}
          </div>
        ) : (
          <p class="text-text-2 text-sm sm:text-base">No blog posts yet.</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>