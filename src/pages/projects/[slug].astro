---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagBadge from '../../components/TagBadge.astro';
import Prose from '../../components/Prose.astro';
import RelatedItems from '../../components/RelatedItems.astro';
import { formatDate } from '../../utils/format-date';
import {
  buildTagNetwork,
  findRelatedItems,
  type SourceItem,
} from '../../utils/tags';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status !== 'draft');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Related via tags: item <-> item edges from the tag network.
const allBlog = await getCollection(
  'blog',
  ({ data }) => data.status === 'published',
);
const allProjects = await getCollection(
  'projects',
  ({ data }) => data.status === 'published',
);
const tagSources: SourceItem[] = [
  ...allBlog.map((entry) => ({
    id: `blog/${entry.id}`,
    type: 'blog' as const,
    title: entry.data.title,
    date: entry.data.date,
    tags: entry.data.tags,
    url: `/blog/${entry.id}/`,
    excerpt: entry.data.seo_description ?? entry.data.excerpt,
  })),
  ...allProjects.map((entry) => ({
    id: `project/${entry.id}`,
    type: 'project' as const,
    title: entry.data.title,
    date: entry.data.date,
    tags: entry.data.tags,
    url: `/projects/${entry.id}/`,
    excerpt: entry.data.excerpt,
  })),
];
const tagNetwork = buildTagNetwork(tagSources);
const related = findRelatedItems(
  `project/${project.id}`,
  tagNetwork,
  3,
);

---

<BaseLayout
  title={`${project.data.title} | Projects`}
  description={project.data.excerpt}
  type="article"
>
  <Header />
  
  <main class="flex-1">
    <article class="py-6 sm:py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <header class="mb-4">
          <div class="grid grid-cols-[1fr_auto] items-end gap-x-4 mb-2">
            <h1 class="text-xl sm:text-2xl lg:text-3xl font-semibold font-serif text-text max-w-[68ch]">{project.data.title}</h1>
            <time class="text-xs sm:text-sm text-text-2">{formatDate(project.data.date)}</time>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-3 pl-0">
            {project.data.tags.map((tag: string) => <TagBadge tag={tag} />)}
          </div>
        </header>
        
        <Prose>
          <Content />
        </Prose>

        <RelatedItems items={related} />

      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
