---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TagBadge from '../../components/TagBadge.astro';
import Prose from '../../components/Prose.astro';
import { formatDate } from '../../utils/format-date';
import {
  buildTagNetwork,
  findRelatedItems,
  type SourceItem,
} from '../../utils/tags';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.status !== 'draft');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Related via tags: item <-> item edges from the tag network.
const allBlog = await getCollection(
  'blog',
  ({ data }) => data.status === 'published',
);
const allProjects = await getCollection(
  'projects',
  ({ data }) => data.status === 'published',
);
const tagSources: SourceItem[] = [
  ...allBlog.map((entry) => ({
    id: `blog/${entry.id}`,
    type: 'blog' as const,
    title: entry.data.title,
    date: entry.data.date,
    tags: entry.data.tags,
    url: `/blog/${entry.id}/`,
    excerpt: entry.data.seo_description ?? entry.data.excerpt,
  })),
  ...allProjects.map((entry) => ({
    id: `project/${entry.id}`,
    type: 'project' as const,
    title: entry.data.title,
    date: entry.data.date,
    tags: entry.data.tags,
    url: `/projects/${entry.id}/`,
    excerpt: entry.data.excerpt,
  })),
];
const tagNetwork = buildTagNetwork(tagSources);
const related = findRelatedItems(
  `project/${project.id}`,
  tagNetwork,
  3,
);

---

<BaseLayout
  title={`${project.data.title} | Projects`}
  description={project.data.excerpt}
  type="article"
>
  <Header />
  
  <main class="flex-1">
    <article class="py-4 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <header class="mb-4">
          <div class="grid grid-cols-[1fr_auto] items-end gap-x-4 mb-2">
            <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold font-serif text-text">{project.data.title}</h1>
            <time class="text-xs sm:text-sm text-text-2">{formatDate(project.data.date)}</time>
          </div>
          
          <div class="flex flex-wrap gap-2 mt-3 pl-0">
            {project.data.tags.map((tag: string) => <TagBadge tag={tag} />)}
          </div>
        </header>
        
        <Prose>
          <Content />
        </Prose>

        {related.length > 0 && (
          <section aria-label="Related via tags" class="mt-8 pt-4 border-t border-border">
            <h2 class="text-sm font-bold font-sans text-text mb-3">Related via tags</h2>
            <ul class="space-y-2 text-sm">
              {related.map((item) => (
                <li>
                  <span class="text-[10px] uppercase tracking-wide text-text-3">
                    {item.type === 'blog' ? 'Post' : 'Project'}
                  </span>{' '}
                  <a href={item.url} class="font-serif font-bold text-text hover:text-accent transition-colors">
                    {item.title}
                  </a>
                  <p class="text-xs text-text-2 line-clamp-1">{item.excerpt}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
