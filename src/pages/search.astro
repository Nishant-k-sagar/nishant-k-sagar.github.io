---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Nishant Kumar Sagar | Search" description="Search articles and projects.">
  <Header />

  <main class="flex-1">
    <section class="py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
        <h1 class="text-lg sm:text-xl lg:text-2xl font-bold font-sans text-green-600 underline decoration-green-600 mb-4">Search</h1>

        <div class="mb-6">
          <label for="search-input" class="block text-sm font-medium text-text mb-1.5">Search articles and projects</label>
          <input
            id="search-input"
            type="search"
            placeholder="Type a title, tag or keyword"
            autocomplete="off"
            class="w-full sm:max-w-md bg-surface border border-border text-text rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
          />
        </div>

        <p id="search-status" class="text-sm text-text-2 mb-3" aria-live="polite"></p>
        <ul id="search-results" class="space-y-4"></ul>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import Fuse from 'fuse.js';

  interface SearchEntry {
    title: string;
    url: string;
    type: 'blog' | 'project';
    tags: string[];
    excerpt: string;
  }

  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results');
  const status = document.getElementById('search-status');

  async function init(): Promise<void> {
    if (!input || !list || !status) return;

    const response = await fetch('/search-index.json');
    const entries = (await response.json()) as SearchEntry[];
    const fuse = new Fuse(entries, {
      keys: ['title', 'tags', 'excerpt'],
      threshold: 0.3,
      includeScore: true,
    });

    function render(query: string): void {
      if (!list || !status) return;
      list.replaceChildren();
      if (query.trim() === '') {
        status.textContent = '';
        return;
      }

      const results = fuse.search(query).map((result) => result.item);
      status.textContent = results.length === 0 ? 'No results' : `${results.length} result(s)`;

      for (const item of results) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = item.url;
        a.textContent = item.title;
        a.className = 'text-accent hover:underline font-medium';
        const p = document.createElement('p');
        p.textContent = item.excerpt;
        p.className = 'text-sm text-text-2';
        li.append(a, p);
        list.append(li);
      }
    }

    input.addEventListener('input', () => render(input.value));

    const query = new URLSearchParams(location.search).get('q');
    if (query) {
      input.value = query;
      render(query);
    }
  }

  init();
</script>
