---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

// The About text lives in src/content/pages/about.md so it can be edited from the CMS.
const about = (
  await getCollection('pages', ({ id, data }) => id === 'about' && data.status === 'published')
)[0];
const AboutContent = about ? (await render(about)).Content : null;
---

<BaseLayout title="Nishant Kumar Sagar | About" description="About Nishant Kumar Sagar.">
  <Header />

  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
      <h1 class="text-2xl sm:text-3xl font-semibold font-serif mb-8">{about?.data.title ?? 'About'}</h1>

      <div class="prose prose-sm sm:prose-base prose-gray dark:prose-invert prose-headings:font-serif prose-headings:font-semibold prose-p:font-serif prose-p:leading-[1.7] prose-li:font-serif prose-li:leading-[1.7] prose-blockquote:font-serif prose-a:text-accent-text hover:prose-a:underline prose-blockquote:border-l-4 prose-blockquote:border-accent prose-blockquote:pl-4 prose-blockquote:italic prose-code:bg-bg-2 dark:prose-code:bg-gray-800 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-pre:bg-bg-2 dark:prose-pre:bg-gray-800 prose-pre:text-text max-w-[68ch]">
        {AboutContent && <AboutContent />}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
