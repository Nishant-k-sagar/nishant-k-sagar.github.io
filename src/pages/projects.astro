---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { sortProjects } from '../utils/sort-posts';

const allProjects = await getCollection('projects', ({ data }) => data.status === 'published');

const projects = sortProjects(allProjects);
---

<BaseLayout title="Nishant Kumar Sagar | Projects" description="Projects I have built, with write-ups and source links.">
  <Header />
  
  <main class="flex-1">
    <section class="py-6 px-4 sm:px-6 lg:px-8">
      <div class="max-w-5xl mx-auto">
         <h1 class="text-xl sm:text-2xl font-semibold font-serif text-green-600 underline decoration-green-600 mb-4">Projects</h1>
         
         {projects.length > 0 ? (
           <div>
            {projects.map((project) => (
              <ProjectCard
                title={project.data.title}
                excerpt={project.data.excerpt}
                slug={project.id}
                date={project.data.date}
                tags={project.data.tags}
                github={project.data.github}
              />
            ))}
          </div>
        ) : (
          <p class="text-text-2 text-sm sm:text-base">No projects yet.</p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>