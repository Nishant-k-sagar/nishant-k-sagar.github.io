---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description?: string;
  image?: string;      // path under /images, defaults to the site OG image
  type?: 'website' | 'article';
  canonical?: string;  // absolute URL, from frontmatter canonical_url
  noindex?: boolean;
  jsonLd?: Record<string, unknown>; // Person on home, Article on blog posts
}

const {
  title,
  description = 'Software developer. Articles, projects and a running timeline.',
  image = '/images/og-default.png',
  type = 'website',
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ecfdf5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)" />

    <link rel="alternate" type="application/rss+xml" title="Nishant Kumar Sagar" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content="Nishant Kumar Sagar" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <script is:inline>
      if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark')
      } else {
        document.documentElement.classList.remove('dark')
      }
    </script>
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'ns:palette'
        var DEFAULTS = { bgHue: 156, bgSat: 52, accentHue: 156, accentSat: 65, inkHue: 156, inkSat: 8 }

        function finite(value, fallback) { var n = Number(value); return Number.isFinite(n) ? n : fallback }
        function clamp(value, min, max) { return Math.min(max, Math.max(min, value)) }
        function wrapHue(value, fallback) { return ((clamp(finite(value, fallback || DEFAULTS.bgHue), -3600, 3600) % 360) + 360) % 360 }
        function part(p, key, fallback, min, max) { return clamp(finite(p[key], fallback), min, max) }
        function normalize(p) {
          p = p || {}
          return {
            bgHue: wrapHue(p.bgHue, DEFAULTS.bgHue),
            bgSat: part(p, 'bgSat', DEFAULTS.bgSat, 0, 70),
            accentHue: wrapHue(p.accentHue, DEFAULTS.accentHue),
            accentSat: part(p, 'accentSat', DEFAULTS.accentSat, 20, 85),
            inkHue: wrapHue(p.inkHue, DEFAULTS.inkHue),
            inkSat: part(p, 'inkSat', DEFAULTS.inkSat, 0, 18),
          }
        }
        function hsl(h, s, l) { return 'hsl(' + Math.round(h * 10) / 10 + ', ' + Math.round(s) + '%, ' + l + '%)' }
        function build(p) {
          var bgHue = p.bgHue
          var bgSat = p.bgSat
          var accentHue = p.accentHue
          var accentSat = p.accentSat
          var inkHue = p.inkHue
          var inkSat = p.inkSat
          var bg2Sat = clamp(bgSat - 15, 0, 70)
          var bg3Sat = clamp(bgSat - 20, 0, 70)
          var surfaceSat = clamp(bgSat * 0.25, 0, 18)
          var borderSat = clamp(bgSat * 0.15, 4, 14)
          var darkBgSat = clamp(bgSat * 0.35, 6, 30)
          var darkBorderSat = clamp(bgSat * 0.28, 8, 30)
          return [
            ':root[data-palette="custom"] {',
            '--color-bg: ' + hsl(bgHue, bgSat, 96) + ';',
            '--color-bg-2: ' + hsl(bgHue, bg2Sat, 92) + ';',
            '--color-bg-3: ' + hsl(bgHue, bg3Sat, 88) + ';',
            '--color-surface: ' + hsl(bgHue, surfaceSat, 99) + ';',
            '--color-border: ' + hsl(bgHue, borderSat, 82) + ';',
            '--color-border-2: ' + hsl(bgHue, borderSat, 66) + ';',
            '--color-text: ' + hsl(inkHue, inkSat, 10) + ';',
            '--color-text-2: ' + hsl(inkHue, inkSat, 33) + ';',
            '--color-text-3: ' + hsl(inkHue, inkSat, 64) + ';',
            '--color-accent: ' + hsl(accentHue, accentSat, 30) + ';',
            '--color-accent-text: ' + hsl(accentHue, accentSat, 26) + ';',
            '--color-accent-bg: ' + hsl(accentHue, clamp(accentSat * 0.35, 10, 40), 94) + ';',
            '}',
            '.dark[data-palette="custom"] {',
            '--color-bg: ' + hsl(bgHue, darkBgSat, 8) + ';',
            '--color-bg-2: ' + hsl(bgHue, darkBgSat, 11) + ';',
            '--color-bg-3: ' + hsl(bgHue, darkBgSat, 15) + ';',
            '--color-surface: ' + hsl(bgHue, darkBgSat, 11) + ';',
            '--color-border: ' + hsl(bgHue, darkBorderSat, 17) + ';',
            '--color-border-2: ' + hsl(bgHue, darkBorderSat, 26) + ';',
            '--color-text: ' + hsl(inkHue, inkSat, 97) + ';',
            '--color-text-2: ' + hsl(inkHue, inkSat, 74) + ';',
            '--color-text-3: ' + hsl(inkHue, inkSat, 57) + ';',
            '--color-accent: ' + hsl(accentHue, accentSat, 72) + ';',
            '--color-accent-text: ' + hsl(accentHue, accentSat, 60) + ';',
            '--color-accent-bg: ' + hsl(accentHue, clamp(accentSat * 0.6, 25, 60), 14) + ';',
            '}'
          ].join('\n')
        }
        function load() {
          try {
            var raw = localStorage.getItem(STORAGE_KEY)
            if (raw) return normalize(JSON.parse(raw))
            localStorage.removeItem('bg-hue')
            localStorage.removeItem('bg-sat')
          } catch (e) {}
          return null
        }
        var current = load() || DEFAULTS
        function save(p) {
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)) } catch (e) {}
        }
        function apply(p, options) {
          current = normalize(Object.assign({}, current, p || {}))
          var style = document.getElementById('bg-palette-style')
          if (!style) {
            style = document.createElement('style')
            style.id = 'bg-palette-style'
            document.head.appendChild(style)
          }
          style.textContent = build(current)
          document.documentElement.dataset.palette = 'custom'
          if (!options || options.save !== false) save(current)
          return Object.assign({}, current)
        }
        function reset() {
          current = Object.assign({}, DEFAULTS)
          try { localStorage.removeItem(STORAGE_KEY) } catch (e) {}
          var style = document.getElementById('bg-palette-style')
          if (style) style.remove()
          try { delete document.documentElement.dataset.palette } catch (e) { document.documentElement.removeAttribute('data-palette') }
          return Object.assign({}, DEFAULTS)
        }
        window.__palette = {
          DEFAULTS: Object.assign({}, DEFAULTS),
          current: function () { return Object.assign({}, current) },
          apply: apply,
          reset: reset,
        }
        try {
          if (localStorage.getItem(STORAGE_KEY)) apply(current, { save: false })
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-text font-sans min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Backgrounds */
    --color-bg: #ecfdf5;
    --color-bg-2: #f5f5f4;
    --color-bg-3: #e7e5e4;
    --color-surface: #ffffff;

    /* Borders */
    --color-border: #d6d3d1;
    --color-border-2: #a8a29e;

    /* Text */
    --color-text: #1c1917;
    --color-text-2: #57534e;
    --color-text-3: #a8a29e;

    /* Accent */
    --color-accent: #0d9488;
    --color-accent-bg: #f0fdfa;
    --color-accent-text: #0f766e;

    /* Fonts */
    --font-serif: 'Lora', 'Georgia', 'Cambria', 'Times New Roman', serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace;

    /* Spacing */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;

    /* Border radius */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-pill: 9999px;

    /* Layout */
    --max-layout: 1100px;
    --max-prose: 700px;
    --max-toc: 220px;
  }

  .dark {
    --color-bg: #111713;
    --color-bg-2: #1a1a1d;
    --color-bg-3: #27272b;
    --color-surface: #1a1a1d;

    --color-border: #27272b;
    --color-border-2: #3a3a3f;

    --color-text: #f8f8f8;
    --color-text-2: #b8b8bc;
    --color-text-3: #88888f;

    --color-accent: #6ee7b7;
    --color-accent-bg: #064e3b;
    --color-accent-text: #34d399;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    hyphens: auto;
    overflow-wrap: break-word;
    word-wrap: break-word;
    -webkit-hyphens: auto;
    -moz-hyphens: auto;
  }
  body {
    font-family: var(--font-serif);
    text-wrap: pretty;
  }
  p, li, blockquote {
    max-width: 85ch;
    text-wrap: pretty;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
    line-break: strict;
    font-size: clamp(0.875rem, 2vw, 1.0625rem);
    line-height: 1.5;
  }
  h1, h2, h3, h4, h5, h6 {
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: none;
  }
  pre code {
    text-wrap: nowrap;
    overflow-x: auto;
    hyphens: none;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-sans);
  }
  button, input, select, textarea {
    font-family: var(--font-sans);
  }
  a {
    transition: color 0.2s ease;
  }
</style>