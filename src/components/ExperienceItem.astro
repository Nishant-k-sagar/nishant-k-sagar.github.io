---
import { render, type CollectionEntry } from "astro:content";
import { formatMonth } from "../utils/format-date";

interface Props {
	entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const { start, end, period } = entry.data;

// "Jan 2024 - Present", "Jan 2024 - Nov 2024", or the free-text fallback.
const range = start
	? `${formatMonth(start)} - ${end ? formatMonth(end) : "Present"}`
	: (period ?? (end ? formatMonth(end) : ""));

const hasMeta = Boolean(entry.data.company || entry.data.location);
---

<article
	class='group border-b border-border dark:border-dark-border-2 py-2.5 sm:py-3 hover:border-border-2 dark:hover:border-dark-border-2 transition-colors'>
	<div class='flex items-baseline justify-between gap-3 mb-1'>
		<h3
			class='text-base sm:text-lg lg:text-xl font-bold font-serif leading-tight text-text dark:text-dark-text group-hover:text-accent dark:group-hover:text-dark-accent transition-colors'>
			{entry.data.title}
		</h3>
		{
			range && (
				<span class='text-[10px] sm:text-xs text-text-3 dark:text-dark-text-3 whitespace-nowrap'>
					{range}
				</span>
			)
		}
	</div>
	{
		hasMeta && (
			<p class='text-xs sm:text-sm font-medium text-green-600 mb-1'>
				{entry.data.url ? (
					<a
						href={entry.data.url}
						target='_blank'
						rel='noopener noreferrer'
						class='hover:underline underline-offset-2'>
						{entry.data.company}
					</a>
				) : (
					entry.data.company
				)}
				{entry.data.location && (
					<span class='text-text-3 dark:text-dark-text-3 font-normal'>
						{" · "}
						{entry.data.location}
					</span>
				)}
			</p>
		)
	}
	<div
		class='experience-body text-text-2 dark:text-dark-text-2 text-xs sm:text-sm leading-relaxed'>
		<Content />
	</div>
</article>

<style>
	.experience-body :global(p) {
		margin: 0;
	}
	.experience-body :global(p + p) {
		margin-top: 0.75em;
	}
	.experience-body :global(ul) {
		margin: 0.5em 0 0;
		padding-left: 1.25em;
		list-style: disc;
	}
	.experience-body :global(ol) {
		margin: 0.5em 0 0;
		padding-left: 1.25em;
		list-style: decimal;
	}
	.experience-body :global(li) {
		margin: 0.2em 0;
	}
	.experience-body :global(a) {
		text-decoration: underline;
	}
	.experience-body :global(strong) {
		font-weight: 600;
	}
</style>
