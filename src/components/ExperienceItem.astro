---
import type { CollectionEntry } from "astro:content";
import { formatExperienceRange } from "../utils/format-date";

interface Props {
	entry: CollectionEntry<"experience">;
}

const { entry } = Astro.props;
const range = formatExperienceRange(entry.data);
const hasMeta = Boolean(entry.data.company || entry.data.location);
---

<a
	href={`/experience/${entry.id}/`}
	class='group block border-b border-border dark:border-dark-border-2 py-3 hover:border-border-2 dark:hover:border-dark-border-2 transition-colors'>
	<div class='flex items-baseline justify-between gap-3 mb-1'>
		<h3
			class='text-base sm:text-lg lg:text-xl font-bold font-serif leading-tight text-text dark:text-dark-text group-hover:text-accent dark:group-hover:text-dark-accent transition-colors'>
			{entry.data.title}
		</h3>
		{
			range && (
				<span class='text-[10px] sm:text-xs text-text-3 dark:text-dark-text-3 whitespace-nowrap'>
					{range}
				</span>
			)
		}
	</div>
	{
		hasMeta && (
			<p class='text-xs sm:text-sm font-medium text-green-600 mb-1'>
				{entry.data.company}
				{entry.data.location && (
					<span class='text-text-3 dark:text-dark-text-3 font-normal'>
						{" · "}
						{entry.data.location}
					</span>
				)}
			</p>
		)
	}
	{
		entry.data.excerpt && (
			<p class='mt-1 text-xs sm:text-sm text-text-2 dark:text-dark-text-2 font-serif leading-[1.55]'>
				{entry.data.excerpt}
			</p>
		)
	}
	<span
		class='mt-2 inline-block text-xs font-medium text-accent dark:text-dark-accent group-hover:underline underline-offset-2'>
		View details
	</span>
</a>
