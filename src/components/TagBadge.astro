---
import { getTagUrl } from '../utils/urls';
import { labelForTag, slugifyTag } from '../utils/tags';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const slug = slugifyTag(tag);
const label = labelForTag(slug) || tag;
---

<a
  href={getTagUrl(tag)}
  class="inline-flex items-center rounded-full border border-border px-3 py-1 text-xs font-medium leading-4 text-text-2 transition-colors hover:border-accent hover:text-accent-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  {label}
</a>
