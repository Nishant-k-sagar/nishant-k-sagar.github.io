---
import BackgroundPicker from "./BackgroundPicker.astro";

const navItems = [
	{ href: "/", label: "Home" },
	{ href: "/blog", label: "Blog" },
	{ href: "/projects", label: "Projects" },
	{ href: "/timeline", label: "Timeline" },
	{ href: "/socials", label: "Socials" },
];

const currentPath = Astro.url.pathname;
const searchActive =
	currentPath === "/search" || currentPath.startsWith("/search/");
---

<!-- Page Loading Indicator -->
<div id="page-loader" class="fixed top-0 left-0 h-1 bg-accent z-[100] transition-all duration-300 ease-out w-0 opacity-0 pointer-events-none"></div>

<header
	class='bg-bg border-b border-stone-200 dark:border-zinc-800 relative z-50'>
	<nav class='relative w-full px-4 sm:px-6 lg:px-8'>
		<div class='flex items-center justify-between h-12 sm:h-14'>
			<a
				href='/'
				class='text-base font-bold font-serif text-text hover:text-accent transition-colors'>
				./Nishant Kumar Sagar
			</a>

			<!-- Desktop Navigation -->
			<div class='hidden md:flex items-center gap-8'>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								"text-sm font-medium transition-colors hover:text-accent",
								currentPath === item.href ||
								(item.href !== "/" &&
									currentPath.startsWith(item.href))
									? "text-text font-medium border-b-2 border-accent"
									: "text-text-2",
							]}>
							{item.label}
						</a>
					))
				}
				<button
					type='button'
					class='search-toggle w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors'
					aria-label='Search'
					aria-controls='header-search'
					aria-expanded='false'
					title='Search'>
					<svg
						class={searchActive ? 'w-4 h-4 text-accent' : 'w-4 h-4 text-text'}
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<BackgroundPicker />
				<button
					id='theme-toggle'
					class='w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors'>
					<svg
						class='w-4 h-4 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
						></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Navigation Buttons -->
			<div class='md:hidden flex items-center gap-2'>
				<button
					type='button'
					class='search-toggle w-6 h-6 bg-bg rounded flex items-center justify-center hover:bg-bg-2 transition-colors'
					aria-label='Search'
					aria-controls='header-search'
					aria-expanded='false'
					title='Search'>
					<svg
						class={searchActive ? 'w-4 h-4 text-accent' : 'w-4 h-4 text-text'}
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<BackgroundPicker />
				<button
					id='mobile-theme-toggle'
					class='w-6 h-6 bg-bg flex items-center justify-center hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
						></path>
					</svg>
				</button>
				<button
					id='mobile-menu-toggle'
					class='w-6 h-6 flex items-center justify-center'>
					<!-- Hamburger Icon -->
					<svg
						id='hamburger-icon'
						class='w-5 h-5 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M4 6h16M4 12h16M4 18h16'></path>
					</svg>
					<!-- Close X Icon -->
					<svg
						id='close-icon'
						class='w-5 h-5 text-text hidden'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M6 18L18 6M6 6l12 12'></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Search bar (expands inside the nav bar on every breakpoint) -->
		<form
			id='header-search'
			action='/search'
			method='get'
			class='hidden absolute inset-0 z-10 items-center bg-bg/95 backdrop-blur-md px-3 sm:px-6 lg:px-8'>
			<div class='mx-auto flex w-full max-w-xl h-10 sm:h-11 items-center gap-1 sm:gap-2 rounded-full border border-border bg-surface pl-1 pr-1 shadow-lg shadow-black/5 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/30 transition duration-200'>
				<button
					type='submit'
					aria-label='Submit search'
					class='w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-text-2 hover:text-accent hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 sm:w-5 sm:h-5'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<label for='header-search-input' class='sr-only'>Search articles and projects</label>
				<input
					id='header-search-input'
					name='q'
					type='search'
					placeholder='Search articles and projects'
					autocomplete='off'
					class='flex-1 min-w-0 bg-transparent outline-none placeholder:text-text-3 text-sm sm:text-base text-text'
				/>
				<kbd class='hidden md:inline-flex items-center justify-center rounded-md border border-border bg-bg-2 px-2 py-0.5 text-[10px] font-mono font-medium text-text-3'>ESC</kbd>
				<button
					id='header-search-close'
					type='button'
					aria-label='Close search'
					class='w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-text-2 hover:text-accent hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 sm:w-5 sm:h-5'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M6 18L18 6M6 6l12 12'></path>
					</svg>
				</button>
			</div>
		</form>
	</nav>

	<!-- Mobile Navigation Menu (Overlay) -->
	<div
		id='mobile-menu'
		class='md:hidden hidden absolute top-full left-0 right-0 bg-bg border-b border-border shadow-lg'>
		<div class='px-4 py-1.5 space-y-0'>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							"block px-2 py-1.5 text-sm font-medium transition-colors w-full text-center",
							currentPath === item.href ||
							(item.href !== "/" &&
								currentPath.startsWith(item.href))
								? "text-accent"
								: "text-text-2 hover:text-text",
						]}>
						{item.label}
					</a>
				))
			}
		</div>
	</div>
</header>

<script is:inline>
	(function () {
		const html = document.documentElement;
		function toggleTheme() {
			const isDark = html.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		}

		function syncPaletteMode(picker) {
			const isDark = html.classList.contains("dark");
			const lightRow = picker.querySelector(".bg-mode-light");
			const darkRow = picker.querySelector(".bg-mode-dark");
			if (lightRow) lightRow.style.display = isDark ? "none" : "";
			if (darkRow) darkRow.style.display = isDark ? "" : "none";
		}

		function handleThemeToggle() {
			toggleTheme();
			document.querySelectorAll(".bg-picker").forEach(syncPaletteMode);
		}

		document.addEventListener("DOMContentLoaded", () => {
			const themeToggle = document.getElementById("theme-toggle");
			const mobileThemeToggle = document.getElementById(
				"mobile-theme-toggle",
			);
			const mobileMenuToggle =
				document.getElementById("mobile-menu-toggle");
			const mobileMenu = document.getElementById("mobile-menu");

			themeToggle?.addEventListener("click", handleThemeToggle);
			mobileThemeToggle?.addEventListener("click", handleThemeToggle);

			const hamburgerIcon = document.getElementById("hamburger-icon");
			const closeIcon = document.getElementById("close-icon");

			// Search icon + expandable search bar
			const searchToggles = document.querySelectorAll(".search-toggle");
			const searchPanel = document.getElementById("header-search");
			const searchInput = document.getElementById("header-search-input");
			const searchClose = document.getElementById("header-search-close");

			function closeSearch() {
				if (!searchPanel) return;
				searchPanel.classList.add("hidden");
				searchPanel.classList.remove("flex");
				searchToggles.forEach((toggle) =>
					toggle.setAttribute("aria-expanded", "false"),
				);
			}

			function openSearch() {
				if (!searchPanel) return;
				searchPanel.classList.remove("hidden");
				searchPanel.classList.add("flex");
				searchToggles.forEach((toggle) =>
					toggle.setAttribute("aria-expanded", "true"),
				);
				searchInput?.focus();
			}

			searchToggles.forEach((toggle) => {
				toggle.addEventListener("click", (e) => {
					e.preventDefault();
					if (searchPanel?.classList.contains("hidden")) {
						openSearch();
					} else {
						closeSearch();
					}
				});
			});

			searchClose?.addEventListener("click", closeSearch);

			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				if (!searchPanel || searchPanel.classList.contains("hidden")) return;
				if (searchPanel.contains(e.target)) return;
				if (e.target.closest(".search-toggle")) return;
				closeSearch();
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") closeSearch();
			});

			// Appearance palette (stored locally in the browser, no server round-trip)
			const pickers = document.querySelectorAll(".bg-picker");
			const DEFAULTS = window.__paletteDefaults ?? {};

			function clamp(value, min, max) {
				return Math.min(max, Math.max(min, value));
			}
			function parseHex(hex) {
				const cleaned = String(hex).trim().replace(/^#/, "");
				return /^([0-9a-fA-F]{6})$/.test(cleaned) ? `#${cleaned.toUpperCase()}` : null;
			}
			function hslFromHex(hex) {
				const clean = parseHex(hex);
				if (!clean) return null;
				const value = parseInt(clean.slice(1), 16);
				const r = (value >> 16) / 255;
				const g = ((value >> 8) & 0xff) / 255;
				const b = (value & 0xff) / 255;
				const max = Math.max(r, g, b);
				const min = Math.min(r, g, b);
				const chroma = max - min;
				let hue = 0;
				if (chroma !== 0) {
					if (max === r) hue = ((g - b) / chroma) % 6;
					else if (max === g) hue = (b - r) / chroma + 2;
					else hue = (r - g) / chroma + 4;
					hue *= 60;
					if (hue < 0) hue += 360;
				}
				const lightness = (max + min) / 2;
				const saturation = chroma === 0 ? 0 : chroma / (1 - Math.abs(2 * lightness - 1));
				return { hue: Math.round(hue), sat: Math.round(clamp(saturation * 100, 0, 100)), light: Math.round(lightness * 100) };
			}
			function hexFromHsl(hue, sat, light) {
				const h = ((hue % 360) + 360) % 360 / 60;
				const s = sat / 100;
				const l = light / 100;
				const c = (1 - Math.abs(2 * l - 1)) * s;
				const x = c * (1 - Math.abs((h % 2) - 1));
				const m = l - c / 2;
				let r = 0;
				let g = 0;
				let b = 0;
				if (h >= 0 && h < 1) [r, g, b] = [c, x, 0];
				if (h >= 1 && h < 2) [r, g, b] = [x, c, 0];
				if (h >= 2 && h < 3) [r, g, b] = [0, c, x];
				if (h >= 3 && h < 4) [r, g, b] = [0, x, c];
				if (h >= 4 && h < 5) [r, g, b] = [x, 0, c];
				if (h >= 5 && h < 6) [r, g, b] = [c, 0, x];
				const part = (v) => Math.round((v + m) * 255).toString(16).padStart(2, "0");
				return `#${part(r)}${part(g)}${part(b)}`.toUpperCase();
			}

			function randomPalette() {
				return {
					bgHue: Math.floor(Math.random() * 360),
					bgSat: Math.floor(20 + Math.random() * 38),
					lightBg: Math.floor(78 + Math.random() * 18),
					darkBg: Math.floor(4 + Math.random() * 12),
					accentHue: Math.floor(Math.random() * 360),
					accentSat: Math.floor(45 + Math.random() * 36),
					inkHue: Math.floor(Math.random() * 360),
					inkSat: Math.floor(6 + Math.random() * 9),
					bgStyle: 'off',
				};
			}

			function closePalettePanels(except) {
				pickers.forEach((other) => {
					if (other === except) return;
					other.querySelector(".bg-picker-panel")?.classList.add("hidden");
					other.querySelector(".bg-picker-toggle")?.setAttribute("aria-expanded", "false");
				});
			}

			function syncBgStyleButtons(picker, style) {
				picker.querySelectorAll("[data-bg-style]").forEach((button) => {
					const active = button.getAttribute("data-bg-style") === style;
					button.setAttribute("aria-pressed", String(active));
					button.classList.toggle("bg-surface", active);
					button.classList.toggle("text-accent", active);
					button.classList.toggle("shadow-sm", active);
				});
			}

			function hexForSlot(palette, slot) {
				if (slot === 'bg') return hexFromHsl(palette.bgHue, palette.bgSat, document.documentElement.classList.contains("dark") ? palette.darkBg : palette.lightBg);
				if (slot === 'accent') return hexFromHsl(palette.accentHue, palette.accentSat, document.documentElement.classList.contains("dark") ? 72 : 30);
				return hexFromHsl(palette.inkHue, palette.inkSat, document.documentElement.classList.contains("dark") ? 97 : 10);
			}

			function writePickerState(picker, palette) {
				palette = palette ?? window.__palette?.current() ?? DEFAULTS;
				syncBgStyleButtons(picker, palette.bgStyle ?? 'off');

				const active = picker.dataset.activeSlot ?? 'bg';
				const hex = hexForSlot(palette, active);
				const hsl = hslFromHex(hex);
				if (!hsl) return;

				const thumb = picker.querySelector('[data-sv-thumb]');
				const hueInput = picker.querySelector('[data-hue-range]');
				const hexInput = picker.querySelector('[data-hex-input]');
				const layer1 = picker.querySelector('[data-hue-layer="1"]');
				const layer2 = picker.querySelector('[data-hue-layer="2"]');

				if (hexInput) hexInput.value = hex;
				if (hueInput) hueInput.value = String(hsl.hue);
				if (layer1) layer1.style.background = `linear-gradient(to right, transparent, hsl(${hsl.hue}, 100%, 50%))`;
				if (layer2) layer2.style.background = `linear-gradient(to bottom, rgba(255,255,255,0.85), transparent 55%, rgba(0,0,0,0.9))`;
				if (thumb) {
					thumb.style.left = `${clamp(hsl.sat, 0, 100)}%`;
					thumb.style.top = `${clamp(100 - hsl.light, 0, 100)}%`;
					thumb.style.background = hex;
				}
			}

			function applyHexToSlot(slot, hex) {
				const parsed = parseHex(hex);
				if (!parsed) return null;
				const hsl = hslFromHex(parsed);
				if (!hsl) return null;
				const current = window.__palette?.current() ?? {};
				const next = { ...current };

				if (slot === 'bg') {
					next.bgHue = hsl.hue;
					next.bgSat = clamp(hsl.sat, 0, 70);
					if (document.documentElement.classList.contains("dark")) next.darkBg = clamp(hsl.light, 4, 22);
					else next.lightBg = clamp(hsl.light, 68, 97);
				}
				if (slot === 'accent') {
					next.accentHue = hsl.hue;
					next.accentSat = clamp(hsl.sat, 20, 85);
				}
				if (slot === 'ink') {
					next.inkHue = hsl.hue;
					next.inkSat = clamp(hsl.sat, 0, 18);
				}
				return window.__palette?.preview(next) ?? next;
			}

			pickers.forEach((picker) => {
				const toggle = picker.querySelector(".bg-picker-toggle");
				const panel = picker.querySelector(".bg-picker-panel");
				picker.dataset.activeSlot = 'bg';

				try {
					writePickerState(picker, window.__palette?.current());
				} catch {}

				toggle?.addEventListener("click", () => {
					if (!panel) return;
					const willOpen = panel.classList.contains("hidden");
					closePalettePanels(picker);
					panel.classList.toggle("hidden", !willOpen);
					toggle.setAttribute("aria-expanded", String(willOpen));
				});

				document.addEventListener("click", (e) => {
					if (!(e.target instanceof Element)) return;
					if (picker.contains(e.target)) return;
					panel?.classList.add("hidden");
					toggle?.setAttribute("aria-expanded", "false");
				});

				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape") {
						panel?.classList.add("hidden");
						toggle?.setAttribute("aria-expanded", "false");
					}
				});

				// slot tabs
				picker.querySelectorAll('[data-slot-tab]').forEach((button) => {
					button.addEventListener("click", () => {
						const slot = button.getAttribute('data-slot-tab');
						if (!slot) return;
						picker.dataset.activeSlot = slot;
						picker.querySelectorAll('[data-slot-tab]').forEach((b) => {
							const isActive = b.getAttribute('data-slot-tab') === slot;
							b.setAttribute('aria-selected', String(isActive));
							b.classList.toggle('border-accent', isActive);
							b.classList.toggle('bg-accent', isActive);
							b.classList.toggle('text-white', isActive);
							b.classList.toggle('border-border', !isActive);
							b.classList.toggle('text-text-2', !isActive);
						});
						writePickerState(picker);
					});
				});

				// square interaction
				const square = panel?.querySelector('[data-sv-square]');
				if (square) {
					square.addEventListener('pointerdown', (e) => {
						e.preventDefault();
						const rect = square.getBoundingClientRect();
						const move = (ev) => {
							const x = clamp(ev.clientX - rect.left, 0, rect.width);
							const y = clamp(ev.clientY - rect.top, 0, rect.height);
							const sat = Math.round((x / rect.width) * 100);
							const light = Math.round(100 - (y / rect.height) * 100);
							const hue = Number(picker.querySelector('[data-hue-range]')?.value ?? 0);
							const hex = hexFromHsl(hue, sat, light);
							const active = picker.dataset.activeSlot ?? 'bg';
							const next = applyHexToSlot(picker, active, hex);
							writePickerState(picker, next);
						};
						move(e);
						const onMove = (ev) => move(ev);
						const onUp = () => {
							window.removeEventListener('pointermove', onMove);
							window.removeEventListener('pointerup', onUp);
						};
						window.addEventListener('pointermove', onMove);
						window.addEventListener('pointerup', onUp);
					});
				}
				const hueRange = panel?.querySelector('[data-hue-range]');
				hueRange?.addEventListener('input', (e) => {
					const hue = Number(e.target.value);
					const active = picker.dataset.activeSlot ?? 'bg';
					const current = window.__palette?.current() ?? {};
					const next = { ...current };
					if (active === 'bg') next.bgHue = hue;
					if (active === 'accent') next.accentHue = hue;
					if (active === 'ink') next.inkHue = hue;
					const previewed = window.__palette?.preview(next) ?? next;
					writePickerState(picker, previewed);
				});

				const hexInput = panel?.querySelector('[data-hex-input]');
				hexInput?.addEventListener('change', (e) => {
					const value = e.target.value;
					const parsed = parseHex(value);
					if (!parsed) return;
					e.target.value = parsed;
					const active = picker.dataset.activeSlot ?? 'bg';
					const next = applyHexToSlot(picker, active, parsed);
					writePickerState(picker, next);
				});
				hexInput?.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') {
						const parsed = parseHex(e.target.value);
						if (!parsed) return;
						const active = picker.dataset.activeSlot ?? 'bg';
						const next = applyHexToSlot(active, parsed);
						writePickerState(picker, next);
					}
				});

				picker.querySelectorAll("[data-basic]").forEach((button) => {
					button.addEventListener("click", () => {
						const hex = button.getAttribute("data-basic");
						if (!hex) return;
						const active = picker.dataset.activeSlot ?? 'bg';
						const next = applyHexToSlot(active, hex);
						writePickerState(picker, next);
					});
				});

				picker.querySelectorAll("[data-preset]").forEach((button) => {
					button.addEventListener("click", () => {
						try {
							const raw = button.getAttribute("data-preset");
							if (!raw) return;
							const payload = JSON.parse(raw);
							const previewed = window.__palette?.preview(payload) ?? payload;
							writePickerState(picker, previewed);
						} catch {}
					});
				});

				picker.querySelector("[data-role='shuffle']")?.addEventListener("click", () => {
					const previewed = window.__palette?.preview(randomPalette()) ?? randomPalette();
					writePickerState(picker, previewed);
				});

				const applyButton = picker.querySelector("[data-role='apply']");
				applyButton?.addEventListener("click", () => {
					window.__palette?.preview(window.__palette.current());
					panel?.classList.add("hidden");
					toggle?.setAttribute("aria-expanded", "false");
				});

				picker.querySelector("[data-role='cancel']")?.addEventListener("click", () => {
					panel?.classList.add("hidden");
					toggle?.setAttribute("aria-expanded", "false");
				});

				picker.querySelector("[data-role='save']")?.addEventListener("click", () => {
					const ok = window.__palette?.save();
					const button = picker.querySelector("[data-role='save']");
					if (button) {
						const original = button.textContent;
						button.textContent = ok ? "Saved" : "Failed";
						button.disabled = true;
						window.setTimeout(() => {
							button.textContent = original;
							button.disabled = false;
						}, 1200);
					}
				});

				picker.querySelectorAll("[data-bg-style]").forEach((button) => {
					button.addEventListener("click", () => {
						try {
							const style = button.getAttribute("data-bg-style");
							if (!style) return;
							const previewed = window.__palette?.preview({ bgStyle: style }) ?? { bgStyle: style };
							writePickerState(picker, previewed);
						} catch {}
					});
				});

				picker.querySelector("[data-role='reset']")?.addEventListener("click", () => {
					const reset = window.__palette?.reset() ?? DEFAULTS;
					writePickerState(picker, reset);
				});
			});

			mobileMenuToggle?.addEventListener("click", () => {
				closeSearch();
				mobileMenu?.classList.toggle("hidden");
				hamburgerIcon?.classList.toggle("hidden");
				closeIcon?.classList.toggle("hidden");
			});

			// Page routing loader
			const loader = document.getElementById("page-loader");
			document.addEventListener("click", (e) => {
				const link = e.target.closest("a");
				if (link && link.href) {
					const url = new URL(link.href);
					const isInternal = url.origin === window.location.origin;
					const isAnchor = url.pathname === window.location.pathname && !!url.hash;
					const isNewTab = link.target === "_blank" || e.ctrlKey || e.metaKey;

					if (isInternal && !isAnchor && !isNewTab && !link.hasAttribute("download")) {
						loader.style.opacity = "1";
						loader.style.width = "30%";
						
						// Simulate loading progress
						setTimeout(() => {
							if (loader.style.width === "30%") {
								loader.style.width = "60%";
							}
						}, 400);
					}
				}
			});

			window.addEventListener("beforeunload", () => {
				loader.style.opacity = "1";
				loader.style.width = "80%";
			});
		});
	})();
</script>
