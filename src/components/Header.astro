---
import BackgroundPicker from "./BackgroundPicker.astro";

const navItems = [
	{ href: "/", label: "Home" },
	{ href: "/blog", label: "Blog" },
	{ href: "/projects", label: "Projects" },
	{ href: "/timeline", label: "Timeline" },
	{ href: "/socials", label: "Socials" },
];

const currentPath = Astro.url.pathname;
const searchActive =
	currentPath === "/search" || currentPath.startsWith("/search/");
---

<!-- Page Loading Indicator -->
<div id="page-loader" class="fixed top-0 left-0 h-1 bg-accent z-[100] transition-all duration-300 ease-out w-0 opacity-0 pointer-events-none"></div>

<header
	class='bg-bg border-b border-stone-200 dark:border-zinc-800 relative z-50'>
	<nav class='relative w-full px-4 sm:px-6 lg:px-8'>
		<div class='flex items-center justify-between h-12 sm:h-14'>
			<a
				href='/'
				class='text-base font-bold font-serif text-text hover:text-accent transition-colors'>
				./Nishant Kumar Sagar
			</a>

			<!-- Desktop Navigation -->
			<div class='hidden md:flex items-center gap-8'>
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								"text-sm font-medium transition-colors hover:text-accent",
								currentPath === item.href ||
								(item.href !== "/" &&
									currentPath.startsWith(item.href))
									? "text-text font-medium border-b-2 border-accent"
									: "text-text-2",
							]}>
							{item.label}
						</a>
					))
				}
				<button
					type='button'
					class='search-toggle w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors'
					aria-label='Search'
					aria-controls='header-search'
					aria-expanded='false'
					title='Search'>
					<svg
						class={searchActive ? 'w-4 h-4 text-accent' : 'w-4 h-4 text-text'}
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<BackgroundPicker />
				<button
					id='theme-toggle'
					class='w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors'>
					<svg
						class='w-4 h-4 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
						></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Navigation Buttons -->
			<div class='md:hidden flex items-center gap-2'>
				<button
					type='button'
					class='search-toggle w-6 h-6 bg-bg rounded flex items-center justify-center hover:bg-bg-2 transition-colors'
					aria-label='Search'
					aria-controls='header-search'
					aria-expanded='false'
					title='Search'>
					<svg
						class={searchActive ? 'w-4 h-4 text-accent' : 'w-4 h-4 text-text'}
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<BackgroundPicker />
				<button
					id='mobile-theme-toggle'
					class='w-6 h-6 bg-bg flex items-center justify-center hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
						></path>
					</svg>
				</button>
				<button
					id='mobile-menu-toggle'
					class='w-6 h-6 flex items-center justify-center'>
					<!-- Hamburger Icon -->
					<svg
						id='hamburger-icon'
						class='w-5 h-5 text-text'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M4 6h16M4 12h16M4 18h16'></path>
					</svg>
					<!-- Close X Icon -->
					<svg
						id='close-icon'
						class='w-5 h-5 text-text hidden'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M6 18L18 6M6 6l12 12'></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Search bar (expands inside the nav bar on every breakpoint) -->
		<form
			id='header-search'
			action='/search'
			method='get'
			class='hidden absolute inset-0 z-10 items-center bg-bg/95 backdrop-blur-md px-3 sm:px-6 lg:px-8'>
			<div class='mx-auto flex w-full max-w-xl h-10 sm:h-11 items-center gap-1 sm:gap-2 rounded-full border border-border bg-surface pl-1 pr-1 shadow-lg shadow-black/5 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/30 transition duration-200'>
				<button
					type='submit'
					aria-label='Submit search'
					class='w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-text-2 hover:text-accent hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 sm:w-5 sm:h-5'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<circle
							cx='11'
							cy='11'
							r='7'
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'></circle>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='m20 20-3.5-3.5'></path>
					</svg>
				</button>
				<label for='header-search-input' class='sr-only'>Search articles and projects</label>
				<input
					id='header-search-input'
					name='q'
					type='search'
					placeholder='Search articles and projects'
					autocomplete='off'
					class='flex-1 min-w-0 bg-transparent outline-none placeholder:text-text-3 text-sm sm:text-base text-text'
				/>
				<kbd class='hidden md:inline-flex items-center justify-center rounded-md border border-border bg-bg-2 px-2 py-0.5 text-[10px] font-mono font-medium text-text-3'>ESC</kbd>
				<button
					id='header-search-close'
					type='button'
					aria-label='Close search'
					class='w-8 h-8 sm:w-9 sm:h-9 rounded-full flex items-center justify-center text-text-2 hover:text-accent hover:bg-bg-2 transition-colors'>
					<svg
						class='w-4 h-4 sm:w-5 sm:h-5'
						fill='none'
						stroke='currentColor'
						viewBox='0 0 24 24'
						aria-hidden='true'>
						<path
							stroke-linecap='round'
							stroke-linejoin='round'
							stroke-width='2'
							d='M6 18L18 6M6 6l12 12'></path>
					</svg>
				</button>
			</div>
		</form>
	</nav>

	<!-- Mobile Navigation Menu (Overlay) -->
	<div
		id='mobile-menu'
		class='md:hidden hidden absolute top-full left-0 right-0 bg-bg border-b border-border shadow-lg'>
		<div class='px-4 py-1.5 space-y-0'>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							"block px-2 py-1.5 text-sm font-medium transition-colors w-full text-center",
							currentPath === item.href ||
							(item.href !== "/" &&
								currentPath.startsWith(item.href))
								? "text-accent"
								: "text-text-2 hover:text-text",
						]}>
						{item.label}
					</a>
				))
			}
		</div>
	</div>
</header>

<script is:inline>
	(function () {
		const html = document.documentElement;
		function toggleTheme() {
			const isDark = html.classList.toggle("dark");
			localStorage.setItem("theme", isDark ? "dark" : "light");
		}

		function syncPaletteMode(picker) {
			const isDark = html.classList.contains("dark");
			const lightRow = picker.querySelector(".bg-mode-light");
			const darkRow = picker.querySelector(".bg-mode-dark");
			if (lightRow) lightRow.style.display = isDark ? "none" : "";
			if (darkRow) darkRow.style.display = isDark ? "" : "none";
		}

		function handleThemeToggle() {
			toggleTheme();
			document.querySelectorAll(".bg-picker").forEach(syncPaletteMode);
		}

		document.addEventListener("DOMContentLoaded", () => {
			const themeToggle = document.getElementById("theme-toggle");
			const mobileThemeToggle = document.getElementById(
				"mobile-theme-toggle",
			);
			const mobileMenuToggle =
				document.getElementById("mobile-menu-toggle");
			const mobileMenu = document.getElementById("mobile-menu");

			themeToggle?.addEventListener("click", handleThemeToggle);
			mobileThemeToggle?.addEventListener("click", handleThemeToggle);

			const hamburgerIcon = document.getElementById("hamburger-icon");
			const closeIcon = document.getElementById("close-icon");

			// Search icon + expandable search bar
			const searchToggles = document.querySelectorAll(".search-toggle");
			const searchPanel = document.getElementById("header-search");
			const searchInput = document.getElementById("header-search-input");
			const searchClose = document.getElementById("header-search-close");

			function closeSearch() {
				if (!searchPanel) return;
				searchPanel.classList.add("hidden");
				searchPanel.classList.remove("flex");
				searchToggles.forEach((toggle) =>
					toggle.setAttribute("aria-expanded", "false"),
				);
			}

			function openSearch() {
				if (!searchPanel) return;
				searchPanel.classList.remove("hidden");
				searchPanel.classList.add("flex");
				searchToggles.forEach((toggle) =>
					toggle.setAttribute("aria-expanded", "true"),
				);
				searchInput?.focus();
			}

			searchToggles.forEach((toggle) => {
				toggle.addEventListener("click", (e) => {
					e.preventDefault();
					if (searchPanel?.classList.contains("hidden")) {
						openSearch();
					} else {
						closeSearch();
					}
				});
			});

			searchClose?.addEventListener("click", closeSearch);

			document.addEventListener("click", (e) => {
				if (!(e.target instanceof Element)) return;
				if (!searchPanel || searchPanel.classList.contains("hidden")) return;
				if (searchPanel.contains(e.target)) return;
				if (e.target.closest(".search-toggle")) return;
				closeSearch();
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape") closeSearch();
			});

			// Appearance palette (stored locally in the browser, no server round-trip)
			const pickers = document.querySelectorAll(".bg-picker");
			const firstPanel = document.querySelector(".bg-picker-panel");
			const DEFAULTS = window.__paletteDefaults ?? {};
			const COLOR_CONTROLS = [...firstPanel.querySelectorAll("input[type=range]")].map((input) => ({
				key: input.dataset.key,
				role: input.dataset.role,
				suffix: input.dataset.suffix ?? "",
			}));

			function randomPalette() {
				const backgroundHue = Math.floor(Math.random() * 361);
				const panel = document.querySelector(".bg-picker-panel");
				const byRole = (role) => panel.querySelector(`[data-role='${role}']`);
				return {
					bgHue: backgroundHue,
					bgSat: Math.floor(Number(byRole("bg-sat")?.min ?? 0) + Math.random() * (Number(byRole("bg-sat")?.max ?? 70) - Number(byRole("bg-sat")?.min ?? 0))),
					lightBg: Math.floor(Number(byRole("light-bg")?.min ?? 68) + Math.random() * (Number(byRole("light-bg")?.max ?? 97) - Number(byRole("light-bg")?.min ?? 68))),
					darkBg: Math.floor(Number(byRole("dark-bg")?.min ?? 4) + Math.random() * (Number(byRole("dark-bg")?.max ?? 22) - Number(byRole("dark-bg")?.min ?? 4))),
					accentHue: Math.floor(Math.random() * 361),
					accentSat: Math.floor(Number(byRole("accent-sat")?.min ?? 20) + Math.random() * (Number(byRole("accent-sat")?.max ?? 85) - Number(byRole("accent-sat")?.min ?? 20))),
					inkHue: backgroundHue,
					inkSat: Math.floor(Number(byRole("ink-sat")?.min ?? 0) + Math.random() * (Number(byRole("ink-sat")?.max ?? 18) - Number(byRole("ink-sat")?.min ?? 0))),
				};
			}

			function closePalettePanels(except) {
				pickers.forEach((other) => {
					if (other === except) return;
					other.querySelector(".bg-picker-panel")?.classList.add("hidden");
					other.querySelector(".bg-picker-toggle")?.setAttribute("aria-expanded", "false");
				});
			}

			function writePaletteControls(picker, palette) {
				palette = palette ?? window.__palette?.current() ?? DEFAULTS;
				for (const control of COLOR_CONTROLS) {
					const input = picker.querySelector(`[data-role='${control.role}']`);
					const output = picker.querySelector(`[data-role='${control.role}-value']`);
					const value = Math.round(Number(palette[control.key] ?? DEFAULTS[control.key]));
					if (input) {
						input.value = String(value);
						input.setAttribute("aria-valuetext", `${value}${control.suffix}`);
					}
					if (output) output.textContent = `${value}${control.suffix}`;
				}
			}

			function readPaletteControls(picker) {
				const palette = {};
				for (const control of COLOR_CONTROLS) {
					const input = picker.querySelector(`[data-role='${control.role}']`);
					palette[control.key] = Number(input?.value ?? DEFAULTS[control.key]);
				}
				return palette;
			}

			function previewFromPicker(picker) {
				const previewed = window.__palette?.preview(readPaletteControls(picker)) ?? readPaletteControls(picker);
				writePaletteControls(picker, previewed);
			}

			pickers.forEach((picker) => {
				const toggle = picker.querySelector(".bg-picker-toggle");
				const panel = picker.querySelector(".bg-picker-panel");

				try {
					writePaletteControls(picker, window.__palette?.current());
				} catch {
					writePaletteControls(picker, DEFAULTS);
				}

				toggle?.addEventListener("click", () => {
					if (!panel) return;
					const willOpen = panel.classList.contains("hidden");
					if (willOpen) syncPaletteMode(picker);
					closePalettePanels(picker);
					panel.classList.toggle("hidden", !willOpen);
					toggle.setAttribute("aria-expanded", String(willOpen));
				});

				document.addEventListener("click", (e) => {
					if (!(e.target instanceof Element)) return;
					if (picker.contains(e.target)) return;
					panel?.classList.add("hidden");
					toggle?.setAttribute("aria-expanded", "false");
				});

				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape") {
						panel?.classList.add("hidden");
						toggle?.setAttribute("aria-expanded", "false");
					}
				});

				for (const control of COLOR_CONTROLS) {
					picker.querySelector(`[data-role='${control.role}']`)?.addEventListener("input", () => previewFromPicker(picker));
				}

				picker.querySelectorAll("[data-preset]").forEach((button) => {
					button.addEventListener("click", () => {
						try {
							const raw = button.getAttribute("data-preset");
							if (!raw) return;
							const payload = JSON.parse(raw);
							const previewed = window.__palette?.preview(payload) ?? payload;
							writePaletteControls(picker, previewed);
						} catch {}
					});
				});

				picker.querySelector("[data-role='shuffle']")?.addEventListener("click", () => {
					const previewed = window.__palette?.preview(randomPalette()) ?? randomPalette();
					writePaletteControls(picker, previewed);
				});

				picker.querySelector("[data-role='save']")?.addEventListener("click", () => {
					window.__palette?.save();
				});

				picker.querySelector("[data-role='reset']")?.addEventListener("click", () => {
					const reset = window.__palette?.reset() ?? DEFAULTS;
					writePaletteControls(picker, reset);
				});
			});

			mobileMenuToggle?.addEventListener("click", () => {
				closeSearch();
				mobileMenu?.classList.toggle("hidden");
				hamburgerIcon?.classList.toggle("hidden");
				closeIcon?.classList.toggle("hidden");
			});

			// Page routing loader
			const loader = document.getElementById("page-loader");
			document.addEventListener("click", (e) => {
				const link = e.target.closest("a");
				if (link && link.href) {
					const url = new URL(link.href);
					const isInternal = url.origin === window.location.origin;
					const isAnchor = url.pathname === window.location.pathname && !!url.hash;
					const isNewTab = link.target === "_blank" || e.ctrlKey || e.metaKey;

					if (isInternal && !isAnchor && !isNewTab && !link.hasAttribute("download")) {
						loader.style.opacity = "1";
						loader.style.width = "30%";
						
						// Simulate loading progress
						setTimeout(() => {
							if (loader.style.width === "30%") {
								loader.style.width = "60%";
							}
						}, 400);
					}
				}
			});

			window.addEventListener("beforeunload", () => {
				loader.style.opacity = "1";
				loader.style.width = "80%";
			});
		});
	})();
</script>
