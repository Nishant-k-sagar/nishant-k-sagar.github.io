---
import { formatDate } from "../utils/format-date";
import { getPostUrl } from "../utils/urls";
import TagChip from "./TagChip.astro";

interface Props {
	title: string;
	excerpt: string;
	slug: string;
	date: string;
	tags: string[];
	postNumber?: number;
}

const { title, excerpt, slug, date, tags, postNumber } = Astro.props;

const formattedDate = formatDate(date);
---

<article
	class='group border-b border-border dark:border-dark-border-2 py-4 hover:border-border-2 dark:hover:border-dark-border-2 transition-colors'>
	<div class='flex items-center justify-between mb-1'>
		<time class='text-[11px] text-text-3 dark:text-dark-text-3'
			>{formattedDate}</time
		>
		<span class='flex items-center gap-1.5 flex-wrap'>
			{
				tags.map((tag) => (
					<TagChip tag={tag} />
				))
			}
		</span>
	</div>
	<h2
		class='text-sm sm:text-base font-semibold font-serif mb-1.5 group-hover:text-accent-text transition-colors leading-snug flex items-center gap-2'>
		{
			postNumber && (
				<span class='text-accent-text text-xs font-mono'>#{postNumber}</span>
			)
		}
		<a href={getPostUrl(slug)} class='truncate hover:underline decoration-1 underline-offset-4'>
			{title}
		</a>
	</h2>
	<p
		class='font-serif text-text-2 dark:text-dark-text-2 text-sm leading-[1.65] mb-0 line-clamp-1'>
		{excerpt}
	</p>
</article>
