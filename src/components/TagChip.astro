---
import { getTagUrl } from '../utils/urls';
import { labelForTag, slugifyTag } from '../utils/tags';

interface Props {
  tag: string;
  small?: boolean;
}

const { tag, small = false } = Astro.props;
const slug = slugifyTag(tag);
const label = labelForTag(slug) || tag;
---

<a
  href={getTagUrl(tag)}
  class:list={[
    'inline-flex items-center whitespace-nowrap rounded-full border border-border font-medium leading-none text-text-2 transition-colors hover:border-accent hover:text-accent-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent',
    small ? 'px-1.5 py-1 text-[10px]' : 'px-2 py-1 text-[11px] sm:text-xs',
  ]}
>
  {label}
</a>
