---
const presets = [
	{ name: 'Mint', hue: 156, sat: 55 },
	{ name: 'Paper', hue: 36, sat: 10 },
	{ name: 'Slate', hue: 215, sat: 18 },
	{ name: 'Sage', hue: 112, sat: 22 },
	{ name: 'Sand', hue: 32, sat: 36 },
	{ name: 'Bloom', hue: 340, sat: 18 },
	{ name: 'Sky', hue: 205, sat: 30 },
	{ name: 'Graphite', hue: 240, sat: 10 },
];
---
<div class="relative bg-picker">
	<button
		type="button"
		class="bg-picker-toggle w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors"
		aria-label="Choose background color"
		title="Background color"
		aria-expanded="false">
		<svg
			class="w-4 h-4 text-text"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			viewBox="0 0 24 24"
			aria-hidden="true">
			<path d="M12 3a9 9 0 0 0-9 9c0 4.97 4.03 9 9 9 1.38 0 2.5-1.12 2.5-2.5 0-.65-.25-1.24-.66-1.7-.41-.46-.66-1.05-.66-1.7a2.5 2.5 0 0 1 2.5-2.5H17a4 4 0 0 0 4-4c0-2.21-4.03-5.6-9-5.6Z"/>
			<circle cx="7.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"/>
			<circle cx="12" cy="7.5" r="1.1" fill="currentColor" stroke="none"/>
			<circle cx="16.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"/>
		</svg>
	</button>

	<div
		class="bg-picker-panel hidden absolute right-0 top-full mt-2 z-50 w-72 max-w-[calc(100vw-1.5rem)] rounded-xl border border-border bg-surface p-3 shadow-2xl"
		role="dialog"
		aria-modal="false"
		aria-label="Background color settings">
		<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-text-3 mb-2">Background</p>

		<div class="grid grid-cols-4 gap-2 mb-3" role="group" aria-label="Preset palettes">
			{presets.map((preset) => (
				<button
					type="button"
					class="h-10 rounded-lg border border-border hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors"
					data-preset-hue={preset.hue}
					data-preset-sat={preset.sat}
					aria-label={`${preset.name} background`}
					title={preset.name}
					style={`background: linear-gradient(135deg, hsl(${preset.hue}, ${preset.sat}%, 96%) 0 50%, hsl(${preset.hue}, ${Math.max(8, Math.round(preset.sat * 0.35))}%, 8%) 50% 100%);`}>
					<span class="sr-only">{preset.name}</span>
				</button>
			))}
		</div>

		<div class="space-y-3">
			<label class="block">
				<span class="flex items-center justify-between gap-2 text-[11px] font-medium text-text-2">
					<span>Hue</span>
					<output data-role="hue-value" class="font-mono text-[10px] text-text-3">156°</output>
				</span>
				<input
					type="range"
					min="0"
					max="360"
					step="1"
					value="156"
					data-role="hue"
					class="mt-1.5 w-full accent-accent cursor-pointer"
					aria-valuetext="156 degrees"
				/>
			</label>

			<label class="block">
				<span class="flex items-center justify-between gap-2 text-[11px] font-medium text-text-2">
					<span>Saturation</span>
					<output data-role="sat-value" class="font-mono text-[10px] text-text-3">55%</output>
				</span>
				<input
					type="range"
					min="0"
					max="70"
					step="1"
					value="55"
					data-role="sat"
					class="mt-1.5 w-full accent-accent cursor-pointer"
				/>
			</label>
		</div>

		<div class="mt-3 flex items-center justify-between gap-2 border-t border-border pt-2">
			<span class="text-[10px] leading-tight text-text-3">Applies to light<br/>and dark mode.</span>
			<button
				type="button"
				data-role="reset"
				class="inline-flex items-center justify-center rounded-md border border-border px-2.5 py-1 text-[11px] font-medium text-text-2 hover:border-accent hover:text-accent transition-colors">
				Reset
			</button>
		</div>
	</div>
</div>
