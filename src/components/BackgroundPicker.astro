---
import { PALETTE_DEFAULTS, PALETTE_CONTROLS, PALETTE_PRESETS } from '../data/palette-defaults';
const presets = PALETTE_PRESETS;
const controls = PALETTE_CONTROLS;
const defaultPalette = PALETTE_DEFAULTS;
---
<div class="relative bg-picker">
	<button
		type="button"
		class="bg-picker-toggle w-6 h-6 rounded flex items-center justify-center hover:bg-bg-3 transition-colors"
		aria-label="Choose appearance colors"
		title="Appearance"
		aria-expanded="false">
		<svg
			class="w-4 h-4 text-text"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			viewBox="0 0 24 24"
			aria-hidden="true">
			<path d="M12 3a9 9 0 0 0-9 9c0 4.97 4.03 9 9 9 1.38 0 2.5-1.12 2.5-2.5 0-.65-.25-1.24-.66-1.7-.41-.46-.66-1.05-.66-1.7a2.5 2.5 0 0 1 2.5-2.5H17a4 4 0 0 0 4-4c0-2.21-4.03-5.6-9-5.6Z"/>
			<circle cx="7.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"/>
			<circle cx="12" cy="7.5" r="1.1" fill="currentColor" stroke="none"/>
			<circle cx="16.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"/>
		</svg>
	</button>

	<div
		class="bg-picker-panel hidden fixed top-12 sm:top-14 right-3 z-[60] w-72 max-w-[calc(100vw-1.5rem)] max-h-[calc(100vh-4rem)] overflow-y-auto rounded-xl border border-border bg-surface p-3 shadow-2xl"
		role="dialog"
		aria-modal="false"
		aria-label="Appearance colors"
		data-default-palette={JSON.stringify(defaultPalette)}>
		<div class="flex items-center justify-between gap-3 mb-2">
			<p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-text-3">Appearance</p>
			<button
				type="button"
				data-role="shuffle"
				class="inline-flex items-center gap-1 rounded-md border border-border px-2 py-1 text-[10px] font-medium text-text-2 hover:border-accent hover:text-accent transition-colors"
				aria-label="Shuffle colors">
				<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>
				</svg>
				Shuffle
			</button>
		</div>

		<div class="grid grid-cols-8 gap-1.5 mb-3" role="group" aria-label="Preset palettes">
			{presets.map((preset) => (
				<button
					type="button"
					class="h-9 rounded-lg border border-border hover:border-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent transition-colors"
					data-preset={JSON.stringify(preset)}
					aria-label={`${preset.name} palette`}
					title={preset.name}
					style={`background: linear-gradient(135deg, hsl(${preset.bgHue}, ${preset.bgSat}%, ${preset.lightBg}%) 0 34%, hsl(${preset.accentHue}, ${preset.accentSat}%, 55%) 34% 66%, hsl(${preset.bgHue}, ${preset.bgSat}%, ${preset.darkBg}%) 66% 100%);`}>
					<span class="sr-only">{preset.name}</span>
				</button>
			))}
		</div>

		<fieldset class="space-y-2.5">
			<legend class="sr-only">Fine-tune colors</legend>
			{controls.map((control) => (
				<label class={`block ${control.role === 'light-bg' ? 'bg-mode-light' : control.role === 'dark-bg' ? 'bg-mode-dark' : ''}`}>
					<span class="flex items-center justify-between gap-2 text-[11px] font-medium text-text-2">
						<span>{control.label}</span>
						<output data-role={`${control.role}-value`} class="font-mono text-[10px] text-text-3">{control.output}</output>
					</span>
					<input
						type="range"
						min={control.min}
						max={control.max}
						step="1"
						value={control.value}
						data-key={control.key}
						data-role={control.role}
						data-suffix={control.suffix}
						class="mt-1 w-full accent-accent cursor-pointer"
					/>
				</label>
			))}
		</fieldset>

		<div class="mt-3 flex items-center justify-end gap-2 border-t border-border pt-2">
			<button
				type="button"
				data-role="reset"
				class="inline-flex items-center justify-center rounded-md border border-border px-2 py-1 text-[11px] font-medium text-text-2 hover:border-accent hover:text-accent transition-colors">
				Reset
			</button>
			<button
				type="button"
				data-role="save"
				class="inline-flex items-center justify-center rounded-md bg-accent px-2.5 py-1 text-[11px] font-semibold text-white transition-colors hover:bg-accent-text">
				Save
			</button>
		</div>
	</div>
</div>
